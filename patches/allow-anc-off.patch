--- /dev/null
+++ b/src/sdk/aap/setters/AapSetAllowOffOption.h
@@ -0,0 +1,31 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2020-2025 Aleksandr Maslov <https://magicpods.app> & Andrei Litvintsev <a.a.litvintsev@gmail.com>
+// License: GPL-3.0
+
+#pragma once
+
+#include "AapRequest.h"
+
+namespace MagicPodsCore
+{
+    // ---------------------------------------------------------------------------
+    // 0400040009003401000000  - allow ANC "Off" mode
+    // 0400040009003402000000  - disable ANC "Off" mode
+    //
+    // AirPods Pro 2 (and later models with Adaptive Audio) gate the ANC "Off"
+    // mode behind this flag. With AllowOffOption disabled (the iPhone
+    // "Press and Hold" / noise-control cycle setting), the device rejects the
+    // ANC-off command (0x0d 0x01) with an error chime and stays in its current
+    // mode. The daemon enables this flag on connect so ANC "Off" always works,
+    // even when the iPhone-side setting is off.
+    // ---------------------------------------------------------------------------
+    class AapSetAllowOffOption : public AapRequest
+    {
+    private:
+        unsigned char _value{};
+
+    public:
+        explicit AapSetAllowOffOption(bool enabled);
+        std::vector<unsigned char> Request() const override;
+    };
+}
